rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == 'admin'; }
    function isInstructor() { return signedIn() && me().role == 'instructor'; }

    match /profiles/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'client';
      allow read, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /activities/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();

      // Cliente può aggiornare soltanto il conteggio iscritti durante una prenotazione.
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked','bookingState','updatedAt'])
        && request.resource.data.booked == resource.data.booked + 1
        && request.resource.data.booked <= resource.data.capacity
      );
    }

    match /activity_bookings/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'confirmed';

      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    match /activity_requests/{id} {
      allow create: if isInstructor()
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if isAdmin()
        || (isInstructor() && resource.data.instructorId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    match /packages/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}